{
  "name": "daily-expense-tracker-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:test": "npm --prefix apps/web run test",
    "mobile:test": "npm --prefix apps/mobile run test",
    "mobile:lint": "npm --prefix apps/mobile run lint",
    "test": "npm run web:test && npm run mobile:test",
    "build": "npm run web:build",
    "core:test": "node --test tests/*.test.mjs",
    "web:e2e": "playwright test",
    "typecheck": "tsc --noEmit --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node -e \"try { require('child_process').execFileSync('husky', { stdio: 'inherit' }); } catch (error) { if (error.code !== 'ENOENT') throw error; }\""
  },
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "typescript": "^5.7.3",
    "prettier": "^3.4.2",
    "husky": "^9.1.7",
    "eslint-config-prettier": "^10.1.8"
  }
}
