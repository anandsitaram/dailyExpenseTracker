{
  "name": "daily-expense-tracker-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "apps/core"
  ],
  "scripts": {
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:test": "npm --prefix apps/web run test",
    "mobile:test": "npm --prefix apps/mobile run test",
    "mobile:lint": "npm --prefix apps/mobile run lint",
    "test": "npm run web:test && npm run mobile:test",
    "build": "npm run web:build",
    "core:test": "node --test tests/*.test.mjs",
    "web:e2e": "playwright test",
    "typecheck": "tsc --noEmit --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
